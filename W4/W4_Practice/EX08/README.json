{
  "project": {
    "name": "User Management API - Refactored",
    "description": "A modular Express.js REST API with separated concerns following MVC architecture",
    "version": "1.0.0",
    "author": "CADT Backend Development"
  },
  "structure": {
    "folders": {
      "controllers": {
        "description": "Business logic handlers for HTTP requests",
        "files": {
          "userController.js": "CRUD operations for users (getAllUsers, getUserById, createUser, updateUser, deleteUser)"
        }
      },
      "models": {
        "description": "Data management and business logic",
        "files": {
          "userModel.js": "In-memory user store with functions to manage user data"
        }
      },
      "routes": {
        "description": "API endpoint definitions and routing",
        "files": {
          "userRoutes.js": "Express router with all user-related routes"
        }
      },
      "middleware": {
        "description": "Request processing middleware",
        "files": {
          "logger.js": "Logs HTTP requests with timestamp, method, and URL",
          "validateUser.js": "Validates name and email in request body"
        }
      },
      "logs": {
        "description": "Log files directory (for future use)",
        "files": {}
      }
    },
    "root_files": {
      "server.js": "Main application file - initializes Express, registers middleware and routes",
      "package.json": "Project dependencies and scripts",
      "README.json": "This documentation file"
    }
  },
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve all users",
      "middleware": ["logger"],
      "response": {
        "status": 200,
        "body": "Array of user objects"
      }
    },
    {
      "method": "GET",
      "path": "/users/:id",
      "description": "Retrieve a specific user by ID",
      "middleware": ["logger"],
      "response": {
        "status": 200,
        "body": "User object with id, name, email"
      },
      "errors": [
        {
          "status": 404,
          "message": "User not found"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Create a new user",
      "middleware": ["logger", "validateUser"],
      "request_body": {
        "name": "string (required)",
        "email": "string (required)"
      },
      "response": {
        "status": 201,
        "body": "Created user object with auto-generated id"
      },
      "errors": [
        {
          "status": 400,
          "message": "Name and email are required"
        }
      ]
    },
    {
      "method": "PUT",
      "path": "/users/:id",
      "description": "Update an existing user",
      "middleware": ["logger", "validateUser"],
      "request_body": {
        "name": "string (required)",
        "email": "string (required)"
      },
      "response": {
        "status": 200,
        "body": "Updated user object"
      },
      "errors": [
        {
          "status": 400,
          "message": "Name and email are required"
        },
        {
          "status": 404,
          "message": "User not found"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/users/:id",
      "description": "Delete a user",
      "middleware": ["logger"],
      "response": {
        "status": 204,
        "body": "No content"
      },
      "errors": [
        {
          "status": 404,
          "message": "User not found"
        }
      ]
    }
  ],
  "installation": {
    "prerequisites": ["Node.js (v14 or higher)", "npm (v6 or higher)"],
    "steps": [
      "Navigate to the EX08 directory",
      "Run: npm install",
      "Run: npm start (or node server.js for one-time run)",
      "Server will start on http://localhost:3000"
    ]
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "Run test suite (to be implemented)"
  },
  "testing_examples": {
    "get_all_users": "curl http://localhost:3000/users",
    "get_specific_user": "curl http://localhost:3000/users/1",
    "create_user": "curl -X POST http://localhost:3000/users -H 'Content-Type: application/json' -d '{\"name\":\"John Doe\",\"email\":\"john@example.com\"}'",
    "update_user": "curl -X PUT http://localhost:3000/users/1 -H 'Content-Type: application/json' -d '{\"name\":\"Jane Doe\",\"email\":\"jane@example.com\"}'",
    "delete_user": "curl -X DELETE http://localhost:3000/users/1",
    "test_validation": "curl -X POST http://localhost:3000/users -H 'Content-Type: application/json' -d '{\"name\":\"Test\"}'"
  },
  "sample_data": {
    "total_users": 20,
    "initial_users": [
      {
        "id": 1,
        "name": "Alice Johnson",
        "email": "alice.johnson@example.com"
      },
      { "id": 2, "name": "Bob Smith", "email": "bob.smith@example.com" },
      { "id": 3, "name": "Charlie Lee", "email": "charlie.lee@example.com" }
    ],
    "note": "See models/userModel.js for complete user list"
  },
  "architecture_benefits": [
    "Separation of Concerns - Each module has a single responsibility",
    "Maintainability - Easy to locate and fix bugs",
    "Testability - Each layer can be tested independently",
    "Scalability - Simple to add new features without affecting existing code",
    "Reusability - Models and controllers can be reused across different routes",
    "Team Collaboration - Multiple developers can work on different modules simultaneously"
  ],
  "future_enhancements": [
    {
      "feature": "Database Integration",
      "description": "Replace in-memory store with MongoDB or PostgreSQL",
      "impact": "Modify only models/userModel.js, no changes to controllers or routes needed"
    },
    {
      "feature": "Authentication",
      "description": "Add JWT-based authentication",
      "files_to_add": [
        "middleware/auth.js",
        "routes/authRoutes.js",
        "controllers/authController.js"
      ]
    },
    {
      "feature": "Advanced Logging",
      "description": "Log to file or external service (Winston, Morgan)",
      "impact": "Enhance middleware/logger.js"
    },
    {
      "feature": "Error Handling",
      "description": "Add centralized error handler middleware",
      "files_to_add": ["middleware/errorHandler.js"]
    },
    {
      "feature": "Input Validation",
      "description": "Add email format validation",
      "impact": "Enhance middleware/validateUser.js"
    },
    {
      "feature": "Rate Limiting",
      "description": "Prevent API abuse",
      "files_to_add": ["middleware/rateLimiter.js"]
    }
  ],
  "dependencies": {
    "express": {
      "version": "^4.18.0",
      "purpose": "Web framework for Node.js"
    },
    "nodemon": {
      "version": "^2.0.0",
      "purpose": "Development tool for auto-restarting server on file changes",
      "dev": true
    }
  },
  "data_flow": {
    "request_flow": [
      "1. HTTP Request arrives",
      "2. Logger middleware logs the request",
      "3. For POST/PUT: validateUser middleware validates body",
      "4. Route matches and forwards to controller",
      "5. Controller processes request and calls model",
      "6. Model performs business logic (CRUD operations)",
      "7. Controller sends response back to client"
    ]
  },
  "notes": {
    "current_state": "In-memory data storage (data lost on server restart)",
    "next_step": "Integrate with database for persistence",
    "validation": "Request body validation happens at middleware level before controller execution",
    "error_codes": {
      "200": "OK - Request successful",
      "201": "Created - Resource successfully created",
      "204": "No Content - Request successful, no content to return",
      "400": "Bad Request - Missing required fields",
      "404": "Not Found - Resource does not exist",
      "500": "Internal Server Error - Server-side error"
    }
  }
}
